# Copy to .env (never committed) and fill in.

# Soniox: the server swaps this for a short-lived key the browser streams audio with.
SONIOX_API_KEY=

# No Anthropic key: the note is written by the Claude Code command line this laptop is
# logged into (`claude -p --model sonnet`), and the server removes ANTHROPIC_API_KEY
# from that call's environment.
